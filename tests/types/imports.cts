import Polynomial = require('polynomial');

const fieldName: Polynomial.FieldName = 'Q';
const coefficients: Polynomial.Coefficients<number> = { 0: 2, 1: 1 };
const input: Polynomial.Input<number> = coefficients;
const polynomial: Polynomial<number> = new Polynomial(input);
const dispersion: number = polynomial.dispersion(10);
const squareRoot: Polynomial<number> | null = polynomial.sqrt();
const leastCommonMultiple: Polynomial<number> = polynomial.lcm('x-1');
const coefficientsArray: number[] = polynomial.toArray(4);
const equal: boolean = polynomial.equals('x+2');
const zero: boolean = polynomial.isZero();
const monic: boolean = polynomial.isMonic();
const divisible: boolean = polynomial.isDivisibleBy('x+1');
const quotientRing: Polynomial.QuotientRing<number> = Polynomial.quotient('x^2+1');
const residue: Polynomial.Residue<number> = quotientRing.create('x');
const evaluatedResidue: Polynomial.Residue<number> = quotientRing.evaluate(polynomial, residue);
const residueRoot: boolean = quotientRing.isRoot(polynomial, residue);
const inverseResidue: Polynomial.Residue<number> = residue.inverse();
const factors: Polynomial<number>[] = polynomial.factor();
const irreducible: boolean = polynomial.isIrreducible();
const fieldOrder: number = quotientRing.order();
const fieldElements: Polynomial.Residue<number>[] = quotientRing.elements();
const primitiveElements: Polynomial.Residue<number>[] = quotientRing.primitiveElements();
const primitivePolynomials: Polynomial<number>[] = quotientRing.primitivePolynomials();
const additiveOrder: number = residue.additiveOrder();
const additiveSubgroup: Polynomial.Residue<number>[] = residue.additiveSubgroup();
const multiplicativeOrder: number = residue.multiplicativeOrder();
const multiplicativeSubgroup: Polynomial.Residue<number>[] = residue.multiplicativeSubgroup();
const primitive: boolean = residue.isPrimitive();
const minimalPolynomial: Polynomial<number> = residue.minimalPolynomial();
const cyclicBasis: Polynomial<number>[] = polynomial.cyclicCodeBasis(3);
const cyclicGenerators: Polynomial<number>[] = Polynomial.cyclicCodeGenerators(3, 1);
const comparison: -1 | 0 | 1 = polynomial.compare('x');
const successor: Polynomial<number> = polynomial.successor();
const enumeration: Polynomial<number>[] = Polynomial.enumerate(2);

